{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Srutam Dictate",
  "version": "0.1.0",
  "identifier": "com.krish.srutam-dictate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Srutam Dictate",
        "url": "index.html",
        "width": 520,
        "height": 640,
        "minWidth": 400,
        "minHeight": 480
      },
      {
        "label": "overlay",
        "title": "Srutam Dictate overlay",
        "url": "overlay.html",
        "width": 300,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
